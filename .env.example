# Segurança e Sessão Flask
SECRET_KEY=troque-por-uma-chave-aleatoria-longa-e-segura
SESSION_COOKIE_SECURE=false

# Conta Administradora (sincronizada automaticamente em NOTE_USERS)
ADMIN_USER=admin
ADMIN_EMAIL=admin@kilo.local
# Gere o hash com:
# python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('sua-senha'))"
ADMIN_PASSWORD_HASH=

# Banco Oracle Database (Thin Mode — sem necessidade de Instant Client)
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=host:1521/service_name

# Opcionais caso utilize mTLS / Wallet no Oracle Autonomous Database em Thin Mode
ORACLE_CONFIG_DIR=
ORACLE_WALLET_LOCATION=
ORACLE_WALLET_PASSWORD=

# Pool de Conexões e Limites
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=4
MAX_CONTENT_LENGTH=16777216
